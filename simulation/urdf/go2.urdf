<?xml version="1.0"?>
<robot name="go2">
  <!-- Robot Twin URDF. 시각 메쉬는 공식 Go2 에셋으로 교체한다. -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.60 0.28 0.12"/></geometry>
      <material name="body"><color rgba="0.18 0.18 0.22 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.60 0.28 0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="6.0"/>
      <inertia ixx="0.07" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.15"/>
    </inertial>
  </link>

  <link name="FL_hip"><visual><geometry><box size="0.06 0.06 0.06"/></geometry></visual></link>
  <link name="FL_thigh"><visual><geometry><box size="0.04 0.04 0.20"/></geometry></visual></link>
  <link name="FL_calf"><visual><geometry><box size="0.03 0.03 0.20"/></geometry></visual></link>
  <link name="FR_hip"><visual><geometry><box size="0.06 0.06 0.06"/></geometry></visual></link>
  <link name="FR_thigh"><visual><geometry><box size="0.04 0.04 0.20"/></geometry></visual></link>
  <link name="FR_calf"><visual><geometry><box size="0.03 0.03 0.20"/></geometry></visual></link>
  <link name="RL_hip"><visual><geometry><box size="0.06 0.06 0.06"/></geometry></visual></link>
  <link name="RL_thigh"><visual><geometry><box size="0.04 0.04 0.20"/></geometry></visual></link>
  <link name="RL_calf"><visual><geometry><box size="0.03 0.03 0.20"/></geometry></visual></link>
  <link name="RR_hip"><visual><geometry><box size="0.06 0.06 0.06"/></geometry></visual></link>
  <link name="RR_thigh"><visual><geometry><box size="0.04 0.04 0.20"/></geometry></visual></link>
  <link name="RR_calf"><visual><geometry><box size="0.03 0.03 0.20"/></geometry></visual></link>

  <joint name="FL_hip_joint" type="revolute">
    <parent link="base_link"/><child link="FL_hip"/>
    <origin xyz="0.19 0.10 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/><limit lower="-1.05" upper="1.05" effort="20" velocity="20"/>
  </joint>
  <joint name="FL_thigh_joint" type="revolute">
    <parent link="FL_hip"/><child link="FL_thigh"/>
    <origin xyz="0 0.04 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-0.66" upper="2.97" effort="30" velocity="20"/>
  </joint>
  <joint name="FL_calf_joint" type="revolute">
    <parent link="FL_thigh"/><child link="FL_calf"/>
    <origin xyz="0 0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2.72" upper="-0.84" effort="30" velocity="20"/>
  </joint>
  <joint name="FR_hip_joint" type="revolute">
    <parent link="base_link"/><child link="FR_hip"/>
    <origin xyz="0.19 -0.10 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/><limit lower="-1.05" upper="1.05" effort="20" velocity="20"/>
  </joint>
  <joint name="FR_thigh_joint" type="revolute">
    <parent link="FR_hip"/><child link="FR_thigh"/>
    <origin xyz="0 -0.04 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-0.66" upper="2.97" effort="30" velocity="20"/>
  </joint>
  <joint name="FR_calf_joint" type="revolute">
    <parent link="FR_thigh"/><child link="FR_calf"/>
    <origin xyz="0 0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2.72" upper="-0.84" effort="30" velocity="20"/>
  </joint>
  <joint name="RL_hip_joint" type="revolute">
    <parent link="base_link"/><child link="RL_hip"/>
    <origin xyz="-0.19 0.10 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/><limit lower="-1.05" upper="1.05" effort="20" velocity="20"/>
  </joint>
  <joint name="RL_thigh_joint" type="revolute">
    <parent link="RL_hip"/><child link="RL_thigh"/>
    <origin xyz="0 0.04 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-0.66" upper="2.97" effort="30" velocity="20"/>
  </joint>
  <joint name="RL_calf_joint" type="revolute">
    <parent link="RL_thigh"/><child link="RL_calf"/>
    <origin xyz="0 0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2.72" upper="-0.84" effort="30" velocity="20"/>
  </joint>
  <joint name="RR_hip_joint" type="revolute">
    <parent link="base_link"/><child link="RR_hip"/>
    <origin xyz="-0.19 -0.10 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/><limit lower="-1.05" upper="1.05" effort="20" velocity="20"/>
  </joint>
  <joint name="RR_thigh_joint" type="revolute">
    <parent link="RR_hip"/><child link="RR_thigh"/>
    <origin xyz="0 -0.04 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-0.66" upper="2.97" effort="30" velocity="20"/>
  </joint>
  <joint name="RR_calf_joint" type="revolute">
    <parent link="RR_thigh"/><child link="RR_calf"/>
    <origin xyz="0 0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2.72" upper="-0.84" effort="30" velocity="20"/>
