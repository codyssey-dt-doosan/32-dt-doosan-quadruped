<?xml version="1.0"?>
<sdf version="1.10">
  <!-- 복도 Virtual Plant: 45 × 3.5 × 4 m -->
  <world name="corridor">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <atmosphere type="adiabatic"/>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>45 3.5 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>45 3.5 0.1</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.45 0.45 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 1.8 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>45 0.1 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>45 0.1 4</size></box></geometry>
          <material>
            <ambient>0.7 0.72 0.75 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -1.8 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>45 0.1 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>45 0.1 4</size></box></geometry>
          <material>
            <ambient>0.7 0.72 0.75 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-22.55 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.7 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.7 4</size></box></geometry>
          <material>
            <ambient>0.65 0.68 0.72 1</ambient>
            <diffuse>0.78 0.8 0.83 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>22.55 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.7 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.7 4</size></box></geometry>
          <material>
            <ambient>0.65 0.68 0.72 1</ambient>
            <diffuse>0.78 0.8 0.83 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://obstacle</uri>
      <name>obstacle_1</name>
      <pose>8 0.6 0.25 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle</uri>
      <name>obstacle_2</name>
      <pose>-6 -0.5 0.25 0 0 0</pose>
    </include>
    <include>
      <uri>model://gauge</uri>
      <name>gauge_corridor</name>
      <pose>15 1.55 1.4 0 0 -1.5708</pose>
    </include>

    <include>
      <uri>model://go2</uri>
      <name>go2</name>
      <pose>-20 0 0.4 0 0 0</pose>
    </include>
  </world>
</sdf>
