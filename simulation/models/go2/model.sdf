<?xml version="1.0"?>
<sdf version="1.10">
  <model name="go2">
    <pose>0 0 0.4 0 0 0</pose>
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <mass>6.0</mass>
        <inertia>
          <ixx>0.07</ixx><iyy>0.12</iyy><izz>0.15</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.60 0.28 0.12</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.60 0.28 0.12</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.18 0.18 0.22 1</diffuse>
        </material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
        </imu>
        <topic>imu</topic>
      </sensor>
      <sensor name="gpu_lidar" type="gpu_lidar">
        <pose>0.15 0 0.08 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.26</min_angle>
              <max_angle>0.26</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
      <sensor name="camera" type="camera">
        <pose>0.28 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>camera</topic>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>20</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="thermal" type="camera">
        <pose>0.28 0 0.02 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>thermal</topic>
        <camera>
          <horizontal_fov>1.0</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- 다리 4개 × hip / thigh / calf (시각·충돌만, 제어는 모듈1에서) -->
    <link name="FL_hip"><pose>0.19 0.10 0 0 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material></visual>
    </link>
    <link name="FL_thigh"><pose>0.19 0.14 -0.08 0 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.04 0.04 0.20</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.04 0.04 0.20</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material></visual>
    </link>
    <link name="FL_calf"><pose>0.19 0.14 -0.26 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.0004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.03 0.03 0.20</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.03 0.03 0.20</size></box></geometry>
        <material><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
    </link>

    <link name="FR_hip"><pose>0.19 -0.10 0 0 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material></visual>
    </link>
    <link name="FR_thigh"><pose>0.19 -0.14 -0.08 0 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.04 0.04 0.20</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.04 0.04 0.20</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material></visual>
    </link>
    <link name="FR_calf"><pose>0.19 -0.14 -0.26 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.0004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.03 0.03 0.20</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.03 0.03 0.20</size></box></geometry>
        <material><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
    </link>

    <link name="RL_hip"><pose>-0.19 0.10 0 0 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material></visual>
    </link>
    <link name="RL_thigh"><pose>-0.19 0.14 -0.08 0 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.04 0.04 0.20</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.04 0.04 0.20</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material></visual>
    </link>
    <link name="RL_calf"><pose>-0.19 0.14 -0.26 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.0004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.03 0.03 0.20</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.03 0.03 0.20</size></box></geometry>
        <material><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
    </link>

    <link name="RR_hip"><pose>-0.19 -0.10 0 0 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><diffuse>0.9 0.55 0.1 1</diffuse></material></visual>
    </link>
    <link name="RR_thigh"><pose>-0.19 -0.14 -0.08 0 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.04 0.04 0.20</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.04 0.04 0.20</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material></visual>
    </link>
    <link name="RR_calf"><pose>-0.19 -0.14 -0.26 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.0004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.03 0.03 0.20</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.03 0.03 0.20</size></box></geometry>
        <material><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
    </link>

    <joint name="FL_hip_joint" type="revolute">
      <parent>base_link</parent><child>FL_hip</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-1.05</lower><upper>1.05</upper></limit></axis>
    </joint>
    <joint name="FL_thigh_joint" type="revolute">
      <parent>FL_hip</parent><child>FL_thigh</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.66</lower><upper>2.97</upper></limit></axis>
    </joint>
    <joint name="FL_calf_joint" type="revolute">
      <parent>FL_thigh</parent><child>FL_calf</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2.72</lower><upper>-0.84</upper></limit></axis>
    </joint>
    <joint name="FR_hip_joint" type="revolute">
      <parent>base_link</parent><child>FR_hip</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-1.05</lower><upper>1.05</upper></limit></axis>
    </joint>
    <joint name="FR_thigh_joint" type="revolute">
      <parent>FR_hip</parent><child>FR_thigh</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.66</lower><upper>2.97</upper></limit></axis>
    </joint>
    <joint name="FR_calf_joint" type="revolute">
      <parent>FR_thigh</parent><child>FR_calf</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2.72</lower><upper>-0.84</upper></limit></axis>
    </joint>
    <joint name="RL_hip_joint" type="revolute">
      <parent>base_link</parent><child>RL_hip</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-1.05</lower><upper>1.05</upper></limit></axis>
    </joint>
    <joint name="RL_thigh_joint" type="revolute">
      <parent>RL_hip</parent><child>RL_thigh</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.66</lower><upper>2.97</upper></limit></axis>
    </joint>
    <joint name="RL_calf_joint" type="revolute">
      <parent>RL_thigh</parent><child>RL_calf</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2.72</lower><upper>-0.84</upper></limit></axis>
    </joint>
    <joint name="RR_hip_joint" type="revolute">
      <parent>base_link</parent><child>RR_hip</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-1.05</lower><upper>1.05</upper></limit></axis>
    </joint>
    <joint name="RR_thigh_joint" type="revolute">
      <parent>RR_hip</parent><child>RR_thigh</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.66</lower><upper>2.97</upper></limit></axis>
    </joint>
    <joint name="RR_calf_joint" type="revolute">
      <parent>RR_thigh</parent><child>RR_calf</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2.72</lower><upper>-0.84</upper></limit></axis>
    </joint>
  </model>
</sdf>
