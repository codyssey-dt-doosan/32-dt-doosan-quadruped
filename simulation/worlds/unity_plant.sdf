<?xml version="1.0"?>
<sdf version="1.10">
  <!-- Unity 발전소(Plant_GazeboMirror) 배치에서 생성 — simulation/scripts/unity_layout_to_sdf.py. 손으로 고치지 않는다. -->
  <!-- 원점 = Unity Spot 시작점, x = 시작 방향(/odom). 격자 770×235 @ 0.1 m -->
  <world name="unity_plant">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <atmosphere type="adiabatic"/>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <model name="plant">
      <static>true</static>
      <link name="link">
        <collision name="floor"><pose>32.500 -1.050 -0.050 0 0 0</pose><geometry><box><size>77.000 23.500 0.100</size></box></geometry></collision><visual name="floor"><pose>32.500 -1.050 -0.050 0 0 0</pose><geometry><box><size>77.000 23.500 0.100</size></box></geometry><material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material></visual>
