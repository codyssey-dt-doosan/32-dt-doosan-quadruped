<?xml version="1.0"?>
<sdf version="1.10">
  <!-- 공장 Virtual Plant: 25 × 18 × 7 m -->
  <world name="factory">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <atmosphere type="adiabatic"/>
    <gravity>0 0 -9.8</gravity>

    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>25 18 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>25 18 0.1</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.3 1</ambient>
            <diffuse>0.38 0.38 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 9.05 3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>25 0.1 7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>25 0.1 7</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1</ambient>
            <diffuse>0.7 0.73 0.76 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -9.05 3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>25 0.1 7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>25 0.1 7</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1</ambient>
            <diffuse>0.7 0.73 0.76 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-12.55 0 3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 18.2 7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 18.2 7</size></box></geometry>
          <material>
            <ambient>0.5 0.53 0.58 1</ambient>
            <diffuse>0.65 0.68 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>12.55 0 3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 18.2 7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 18.2 7</size></box></geometry>
          <material>
            <ambient>0.5 0.53 0.58 1</ambient>
            <diffuse>0.65 0.68 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://obstacle</uri>
      <name>rack_a</name>
      <pose>6 4 0.4 0 0 0.3</pose>
    </include>
    <include>
      <uri>model://obstacle</uri>
      <name>rack_b</name>
      <pose>-5 -3 0.4 0 0 -0.4</pose>
    </include>
    <include>
      <uri>model://gauge</uri>
      <name>gauge_line1</name>
      <pose>10 8.7 1.5 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>model://gauge</uri>
      <name>gauge_line2</name>
      <pose>-8 8.7 1.5 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>model://gas_tank</uri>
      <name>gas_tank_1</name>
      <pose>8 -6 0.75 0 0 0</pose>
    </include>
    <include>
      <uri>model://gas_tank</uri>
      <name>gas_tank_2</name>
      <pose>10 -6 0.75 0 0 0</pose>
    </include>

    <include>
      <uri>model://go2</uri>
      <name>go2</name>
      <pose>-10 0 0.4 0 0 0</pose>
    </include>
  </world>
</sdf>
